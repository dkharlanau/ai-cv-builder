{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkharlanau/ai-cv-builder/blob/main/schema/profile.schema.json",
  "title": "Portable professional profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "headline", "summary", "url", "skills", "review"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "format": "uri", "pattern": "^https://" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "headline": { "type": "string", "minLength": 1, "maxLength": 180 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sameAs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidenceUrl"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "evidenceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "organization", "start", "highlights"],
        "properties": {
          "role": { "type": "string", "minLength": 1, "maxLength": 120 },
          "organization": { "type": "string", "minLength": 1, "maxLength": 120 },
          "start": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
          "end": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
              { "type": "null" }
            ]
          },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastReviewed", "publicDataOnly", "indexable"],
      "properties": {
        "lastReviewed": { "type": "string", "format": "date" },
        "publicDataOnly": { "const": true },
        "indexable": { "type": "boolean" }
      }
    }
  }
}
